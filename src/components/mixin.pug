mixin btn-next()
	.btn.btn-next(class="w-12 h-12 border border-none bg-white  flex justify-center items-center rounded-2 ")
		<i class="fa-light fa-angle-left text-gray-500 "></i>
mixin btn-prev()
	.btn.btn-prev(class="w-12 h-12 border border-none bg-white  flex justify-center items-center rounded-2")
		<i class="fa-light fa-angle-right text-gray-500 "></i>
mixin Breadcrumb-custom(items)
	.flex.items-center
		each item, i in items
			- const isLast = i === items.length - 1
			p(
				class=[
					'px-2 py-0', 
					'body-18',
					isLast ? 'font-bold text-primary-1' : 'font-normal text-gray-700'
				]
			)= item
			if !isLast
				//- thanh ngăn cách ngắn giữa các phần tử
				span(class="inline-block w-[1px] h-[13px] bg-gray-400 rounded mx-1")
